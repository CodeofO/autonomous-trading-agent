# ================================================================
#  AI 펀드매니저 설정 (기본 모의투자)
#  1) 이 파일을 .env 로 복사:  cp .env.example .env   (run.sh 가 없으면 자동 복사)
#  2) 필요한 값만 채우고        ./run.sh
#  .env 는 git 에 올라가지 않습니다. 이 예시 파일에는 실제 키를 쓰지 마세요.
#  필수: TOSS_CLIENT_ID / TOSS_CLIENT_SECRET (실제 종목 시세). LLM 이 없으면 규칙 기반 매니저로 동작합니다.
# ================================================================

# 거래 모드
#   paper : 자체 모의계좌 (기본). 토스 시세로 가상 체결, 실제 돈은 움직이지 않음
#   live  : 토스증권 실계좌로 **실제 주문**. 아래 LIVE_TRADING_CONFIRM 문구까지 넣어야 켜짐
#           켜기 전에 README 의 '실제 투자' 절을 꼭 읽으세요. 손실을 포함한 결과는 사용자 책임입니다.
TRADING_MODE=paper
# live 일 때만: 정확히 I_UNDERSTAND_REAL_MONEY 라고 적어야 실거래가 켜집니다
LIVE_TRADING_CONFIRM=
# live 일 때만: 주문할 계좌 번호(accountSeq). 비우면 종합계좌가 하나일 때 자동 선택
TOSS_ACCOUNT_SEQ=
# live 일 때만: 하루 매수 총액 상한(원). 설정 화면의 리스크 한도와 별개로 코드가 강제
LIVE_DAILY_BUY_LIMIT=5000000

# ---------------------------------------------------------------
# 토스증권 Open API — 실제 종목 시세. paper 모드에서는 조회만, live 모드에서는 주문·계좌 API 도 사용
#   발급: 토스증권 WTS 로그인 → 설정 > Open API → client_id / client_secret
#   필수: 같은 화면 하단 '허용 IP 관리'에 이 컴퓨터의 공인 IP 를 등록 (미등록이면 403)
#   시세는 실제 종목·실제 한국 시각으로만 동작합니다(목업 없음).
# ---------------------------------------------------------------
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# ---------------------------------------------------------------
# LLM (OpenAI 호환 Chat Completions)  — 매니저의 '두뇌'
#   예) OpenAI:      https://api.openai.com/v1
#       로컬 Ollama: http://localhost:11434/v1   (Docker 실행이면 http://host.docker.internal:11434/v1)
#       기타 OpenAI 호환 게이트웨이의 base url
#   셋 중 하나라도 비면 규칙 기반 매니저로 동작합니다.
# ---------------------------------------------------------------
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# auto: 도구 호출 시도 → 미지원이면 JSON 모드로 자동 전환 | tools | json
LLM_TOOL_MODE=auto
LLM_TEMPERATURE=0.2
# 추론형 모델(Qwen3 등)은 추론 토큰도 여기에 포함되므로 넉넉히
LLM_MAX_TOKENS=8192
# 세션당 최대 도구 호출 단계 (비용 상한)
LLM_MAX_STEPS=24

# ---------------------------------------------------------------
# 재무제표·뉴스 (무료 키, 선택 — 토스 API 에는 재무제표·뉴스가 없음)
#   DART_API_KEY           : opendart.fss.or.kr 인증키 (재무제표·공시)
#   NAVER_CLIENT_ID/SECRET : developers.naver.com 애플리케이션 등록 (검색 API → 뉴스)
# ---------------------------------------------------------------
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------------------------------------------------------------
# 휴대폰 알림 (Web Push — 체결·리스크 차단·킬 스위치·오류)
#   VAPID_PRIVATE_KEY : 알림 서명용 개인키. 비워 두면 ./run.sh 가 만들어 .env 에 넣는다 (직접 넣을 필요 없음)
#   VAPID_SUBJECT     : 푸시 서비스가 연락할 곳. mailto:메일주소 또는 https://호스트 (경로 없이)
#   아이폰은 HTTPS 주소(예: Tailscale)로 열고 '홈 화면에 추가'한 앱에서 설정 > 휴대폰 알림을 켠다
# ---------------------------------------------------------------
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com

# 장중 LLM 판단 간격(분). 60 → 08:35 장전 + 10:00~15:00 매시 정각. 30 → 30분마다. 0 → 08:35·14:00 두 번
# (세션 1회에 LLM 토큰이 많이 쓰이니 간격을 줄일수록 비용이 늘어납니다)
AGENT_INTERVAL_MINUTES=60

# ---------------------------------------------------------------
# 가상 계좌
# ---------------------------------------------------------------
PAPER_INITIAL_CASH=10000000
PAPER_COMMISSION_RATE=0.00015
# 매도 증권거래세 — 시장·연도별 세율을 확인해 조정하세요
PAPER_SELL_TAX_RATE=0.0020
PAPER_SLIPPAGE_BPS=5
# 하루 거래량 대비 체결 가능 비율 (초과분은 부분체결 후 취소)
PAPER_MAX_VOLUME_PARTICIPATION=0.05

# ---------------------------------------------------------------
# 앱
# ---------------------------------------------------------------
# 접속 포트 (비우면 프론트 15173 / 백엔드 18000)
# FRONTEND_PORT=15173
# BACKEND_PORT=18000
# 로그인 사용 여부 (기본 false: 로그인 없음, 127.0.0.1 에서만 접속 가능)
# AUTH_ENABLED=false
# 세션 서명 키 (로그인 사용 시, 비우면 backend/data/.secret_key 에 자동 생성)
APP_SECRET_KEY=
LOG_LEVEL=INFO
# 로컬 실행 기본은 SQLite(backend/data/app.db). docker compose 는 PostgreSQL 을 자동 사용합니다.
# DATABASE_URL=sqlite:///./data/app.db
# docker compose 의 PostgreSQL 비밀번호 (로컬 전용, 외부 포트 미노출)
# POSTGRES_PASSWORD=
