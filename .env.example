# ================================================================
#  Toss Paper Trader 설정 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#    cp .env.example .env
#  .env 는 git 에 커밋되지 않습니다. 실제 키를 이 예시 파일에 쓰지 마세요.
# ================================================================

# 거래 모드 — 'paper' 외 값은 기동 자체가 거부됩니다(실계좌 주문 경로 없음).
TRADING_MODE=paper

# 토스증권 Open API (시세 조회 전용으로만 사용, 주문 API 는 호출하지 않음)
#  WTS > 설정 > Open API 에서 발급, 허용 IP 등록 필요. 비워두면 MockBroker(가상 시세)로 동작.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 브로커: auto(키 있으면 toss_paper, 없으면 mock) | mock | toss_paper
BROKER=auto
# 시계: auto(mock→simulated, toss→real) | real | simulated(mock 전용 가속 시뮬레이션)
CLOCK_MODE=auto
# 시뮬레이션 배속 (60 = 실제 1초에 1분봉 1개)
SIM_SPEED=60

# 가상 계좌
PAPER_INITIAL_CASH=10000000
PAPER_COMMISSION_RATE=0.00015
PAPER_SELL_TAX_RATE=0.0020
PAPER_SLIPPAGE_BPS=5

# 세션 서명 키 (비워두면 data/ 에 자동 생성·보관)
APP_SECRET_KEY=

# DB — 로컬 실행 기본은 SQLite. docker compose 는 PostgreSQL 을 자동 지정합니다.
# DATABASE_URL=sqlite:///./data/app.db
LOG_LEVEL=INFO
