# ================================================================
#  AI 펀드매니저 설정 (기본 모의투자)
#  1) 이 파일을 .env 로 복사:  cp .env.example .env   (run.sh 가 없으면 자동 복사)
#  2) 필요한 값만 채우고        ./run.sh
#  .env 는 git 에 올라가지 않습니다. 이 예시 파일에는 실제 키를 쓰지 마세요.
#  필수: TOSS_CLIENT_ID / TOSS_CLIENT_SECRET (실제 종목 시세). LLM 이 없으면 규칙 기반 매니저로 동작합니다.
# ================================================================

# 거래 모드
#   paper : 자체 모의계좌 (기본). 토스 시세로 가상 체결, 실제 돈은 움직이지 않음
#   live  : 토스증권 실계좌로 **실제 주문**. 아래 LIVE_TRADING_CONFIRM 문구까지 넣어야 켜짐
#           켜기 전에 README 의 '실제 투자' 절을 꼭 읽으세요. 손실을 포함한 결과는 사용자 책임입니다.
TRADING_MODE=paper
# live 일 때만: 정확히 I_UNDERSTAND_REAL_MONEY 라고 적어야 실거래가 켜집니다
LIVE_TRADING_CONFIRM=
# live 일 때만: 주문할 계좌 번호(accountSeq). 비우면 종합계좌가 하나일 때 자동 선택
TOSS_ACCOUNT_SEQ=
# live 일 때만: 하루 매수 총액 상한(원). 설정 화면의 리스크 한도와 별개로 코드가 강제
LIVE_DAILY_BUY_LIMIT=5000000

# ---------------------------------------------------------------
# 토스증권 Open API — 실제 종목 시세. paper 모드에서는 조회만, live 모드에서는 주문·계좌 API 도 사용
#   발급: 토스증권 WTS 로그인 → 설정 > Open API → client_id / client_secret
#   필수: 같은 화면 하단 '허용 IP 관리'에 이 컴퓨터의 공인 IP 를 등록 (미등록이면 403)
#   시세는 실제 종목·실제 한국 시각으로만 동작합니다(목업 없음).
# ---------------------------------------------------------------
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# ---------------------------------------------------------------
# LLM (OpenAI 호환 Chat Completions)  — 매니저의 '두뇌'
#   예) OpenAI:      https://api.openai.com/v1
#       Google:      https://generativelanguage.googleapis.com/v1beta/openai
#       OpenRouter:  https://openrouter.ai/api/v1   (키 sk-or-v1-…, LLM_MODEL 은 openai/… 처럼 '회사/모델' id)
#       로컬 Ollama: http://localhost:11434/v1   (Docker 실행이면 http://host.docker.internal:11434/v1)
#       기타 OpenAI 호환 게이트웨이의 base url
#   OpenAI·Google·OpenRouter 키는 LLM_BASE_URL 을 비워도 키 모양으로 공식 주소를 씁니다.
#   OpenAI·Google 이면 설정 화면에서 그 회사 모델을 골라 바꿀 수 있고, LLM_MODEL 은 처음 쓸 모델입니다.
#   OpenRouter 면 설정 화면에서 OpenRouter 목록(도구 호출을 지원하는 모델만)을 불러와 고를 수 있습니다.
#   (Anthropic 키는 전용 API 연결 전이라 아직 쓸 수 없습니다)
#   모델이나 키가 비면 규칙 기반 매니저로 동작합니다.
# ---------------------------------------------------------------
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# auto: 도구 호출 시도 → 미지원이면 JSON 모드로 자동 전환 | tools | json
LLM_TOOL_MODE=auto
LLM_TEMPERATURE=0.2
# 추론형 모델(Qwen3 등)은 추론 토큰도 여기에 포함되므로 넉넉히
LLM_MAX_TOKENS=8192
# 세션당 최대 도구 호출 단계 (비용 상한)
LLM_MAX_STEPS=24
# 호출 방식: auto(api.openai.com 이면 Responses API, 그 밖은 Chat Completions) | chat | responses
LLM_API=auto
# 추론 강도 (none·minimal·low·medium·high·xhigh·max 중 모델이 지원하는 값). 비우면 모델 기본값
LLM_REASONING_EFFORT=

# ---------------------------------------------------------------
# 테스트용 LLM (선택) — 코드를 고친 뒤 실제 호출로 확인할 때만 쓰는 별도 엔드포인트
#   앱(판단·답장)은 위 LLM_* 만 쓰고, 이 값들은 ./run.sh llm-check 점검에만 쓴다
#   실서비스와 다른 키(예: 사용 한도를 작게 건 별도 프로젝트 키)를 넣는다. 비우면 점검이 실행되지 않는다
#   LLM_TEST_API: auto | chat | responses (auto: api.openai.com 이면 responses)
# ---------------------------------------------------------------
LLM_TEST_BASE_URL=
LLM_TEST_MODEL=
LLM_TEST_API_KEY=
LLM_TEST_API=auto
LLM_TEST_REASONING_EFFORT=

# ---------------------------------------------------------------
# 재무제표·뉴스 (무료 키, 선택 — 토스 API 에는 재무제표·뉴스가 없음)
#   DART_API_KEY           : opendart.fss.or.kr 인증키 (재무제표·공시)
#   NAVER_CLIENT_ID/SECRET : 뉴스 검색 키. 받은 곳에 맞춰 NAVER_API 를 고른다
#   NAVER_API              : hub        = 네이버 클라우드 콘솔 > NAVER API HUB > Application > 인증 정보 (기본)
#                            developers = developers.naver.com > 내 애플리케이션 (예전 방식)
#   넣은 뒤 ./run.sh news-check 로 점검
# ---------------------------------------------------------------
DART_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API=hub

# ---------------------------------------------------------------
# 구글 검색 (선택, **유료**) — 매니저의 search_web 도구 (미국 종목·해외 뉴스에 유용, 국장·미장 공통)
#   Gemini API 의 'Google 검색 그라운딩(Grounding with Google Search)' 을 쓴다.
#   키: aistudio.google.com > API 키. **결제(유료 등급) 등록이 필요** — 무료 등급에는 검색 그라운딩이 없다.
#   요금(2026-11-04 기준, aistudio.google.com/docs/pricing): 검색 월 5,000회 무료, 그 뒤 1,000회당 $14
#     + 모델 토큰 요금. 판단 세션 1회에 최대 GOOGLE_SEARCH_MAX_PER_SESSION 회만 검색한다.
#   GEMINI_API_KEY 를 비우면 꺼진다 (도구가 매니저에게 주어지지 않음).
# ---------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_SEARCH_MODEL=gemini-3.5-flash-lite
GOOGLE_SEARCH_MAX_PER_SESSION=3

# ---------------------------------------------------------------
# 휴대폰 알림 (Web Push — 체결·리스크 차단·킬 스위치·오류)
#   VAPID_PRIVATE_KEY : 알림 서명용 개인키. 비워 두면 ./run.sh 가 만들어 .env 에 넣는다 (직접 넣을 필요 없음)
#   VAPID_SUBJECT     : 푸시 서비스가 연락할 곳. mailto:메일주소 또는 https://호스트 (경로 없이)
#   아이폰은 HTTPS 주소(예: Tailscale)로 열고 '홈 화면에 추가'한 앱에서 설정 > 휴대폰 알림을 켠다
# ---------------------------------------------------------------
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com

# 장중 LLM 판단 간격(분). 60 → 08:35 장전 + 10:00~15:00 매시 정각. 30 → 30분마다. 0 → 08:35·14:00 두 번
# (세션 1회에 LLM 토큰이 많이 쓰이니 간격을 줄일수록 비용이 늘어납니다)
# 설정 화면 '판단 주기'에서 시작·끝·주기를 정하면 그 값이 우선합니다 ('기본값으로'를 누르면 다시 이 값).
AGENT_INTERVAL_MINUTES=60

# ---------------------------------------------------------------
# 가상 계좌
# ---------------------------------------------------------------
PAPER_INITIAL_CASH=10000000
PAPER_COMMISSION_RATE=0.00015
# 매도 증권거래세 — 시장·연도별 세율을 확인해 조정하세요
PAPER_SELL_TAX_RATE=0.0020
PAPER_SLIPPAGE_BPS=5
# 하루 거래량 대비 체결 가능 비율 (초과분은 부분체결 후 취소)
PAPER_MAX_VOLUME_PARTICIPATION=0.05

# ---------------------------------------------------------------
# 미장 (미국 주식) — D-48, D-55
# 시세는 토스증권(같은 키·같은 토큰). 거래 모드는 국장(TRADING_MODE)과 따로 정한다.
# 정규장: 뉴욕 09:30~16:00 = 한국 시각 23:30~06:00 (서머타임 22:30~05:00)
# ---------------------------------------------------------------
US_MARKET_ENABLED=true
# paper: 자체 달러 모의계좌 (기본) | live: 토스증권 실계좌로 미국 주식 **실제 주문**
#   live 는 아래 US_LIVE_TRADING_CONFIRM 문구까지 넣어야 켜짐. 토스 앱에서 해외주식 약관·위험고지 절차가
#   끝나 있어야 하고, 달러 주문가능금액(buying-power USD)으로 주문한다. 장 시작 전 주문은 보내지 않는다.
US_TRADING_MODE=paper
# US_TRADING_MODE=live 일 때만: 정확히 I_UNDERSTAND_REAL_MONEY
US_LIVE_TRADING_CONFIRM=
# US_TRADING_MODE=live 일 때만: 하루 매수 총액 상한(달러). 설정 화면의 리스크 한도와 별개로 코드가 강제
US_LIVE_DAILY_BUY_LIMIT=3000
# 비우면 data/us_market.db (국장 DB 와 따로)
# US_DATABASE_URL=sqlite:///./data/us_market.db
# 시작 자금(달러)
PAPER_US_INITIAL_CASH=10000
# 매매 수수료율 (토스 문서 예시 0.1%). 미국 SEC·FINRA TAF 수수료와 국내 증권거래세는 넣지 않음
PAPER_US_COMMISSION_RATE=0.001
PAPER_US_SLIPPAGE_BPS=5
# 장중 판단 간격(분). 비우면 AGENT_INTERVAL_MINUTES 와 같음
# US_AGENT_INTERVAL_MINUTES=60

# ---------------------------------------------------------------
# 앱
# ---------------------------------------------------------------
# 접속 포트 (비우면 프론트 15173 / 백엔드 18000)
# FRONTEND_PORT=15173
# BACKEND_PORT=18000
# 로그인 사용 여부 (기본 false: 로그인 없음, 127.0.0.1 에서만 접속 가능)
# AUTH_ENABLED=false
# 세션 서명 키 (로그인 사용 시, 비우면 backend/data/.secret_key 에 자동 생성)
APP_SECRET_KEY=
LOG_LEVEL=INFO
# 로컬 실행 기본은 SQLite(backend/data/app.db). docker compose 는 PostgreSQL 을 자동 사용합니다.
# DATABASE_URL=sqlite:///./data/app.db
# docker compose 의 PostgreSQL 비밀번호 (로컬 전용, 외부 포트 미노출)
# POSTGRES_PASSWORD=
