{
  "name": "toss-paper-trader-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" && tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.75.7",
    "lightweight-charts": "5.0.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router-dom": "7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "9.26.0",
    "@playwright/test": "1.52.0",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.15.18",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.26.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.1.0",
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vite": "6.3.7",
    "vitest": "3.1.4"
  }
}
